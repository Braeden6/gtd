{
  "manifest_version": 3,
  "version": "1.0.0",
  "short_name": "GTD Chrome Extension",
  "name": "GTD Chrome Extension",
  "icons": {
    "16": "favicon.ico",
    "32": "favicon.ico", 
    "192": "logo192.png",
    "512": "logo512.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/contentScript.tsx"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
